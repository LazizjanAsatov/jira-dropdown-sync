# Copy to .env and fill in. Never commit .env. Key names aren't case-sensitive.

# --- Telegram ---------------------------------------------------------------
# Your bot (from @BotFather). Needs Bot-to-Bot Communication Mode ON and Group Privacy OFF.
TELEGRAM_BOT_TOKEN=
# The bot that answers REPORT_COMMAND with an Excel file (username, with or without @)
REPORT_BOT=ReportBot
# The command your bot writes in the group; it's sent as /command@REPORT_BOT
REPORT_COMMAND=/report
# Only take Excel files whose name starts with this (empty = any .xlsx from REPORT_BOT)
REPORT_FILE_PREFIX=
# The group where both bots are (a negative number; README explains how to find it)
TELEGRAM_GROUP_ID=-1001234567890

# --- Approval ---------------------------------------------------------------
# True (default): post the new names with ✅/❌ buttons and only add after someone presses ✅.
# False: add straight away and tell the group what was added (25-name limit, see --no-limit).
BY_CONFIRMATION=True

# --- Jira Cloud -------------------------------------------------------------
# The account must be a Jira admin to edit the field's options.
JIRA_URL=https://<your-site>.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
# The select-list custom field to keep in sync (exact name)
JIRA_FIELD=Merchant

# --- Reading the report -----------------------------------------------------
# Column headers in the Excel
MERCHANT_COLUMN=Merchant
GROUP_COLUMN=Group
# Words removed from merchant names, comma-separated (e.g. a marker for a variant of a merchant)
DROP_WORDS=
# Words that don't make two names different, comma-separated (e.g. your company tag, Ltd, LLC)
IGNORE_WORDS=
# Groups that go to Jira as the group name only, without their merchants, comma-separated (whole group names)
GROUPS_WITHOUT_MERCHANTS=
# The rows read must match a "Total — N ..." row under the table
CHECK_TOTAL_ROW=True
